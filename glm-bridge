#!/usr/bin/env bash
# ============================================================================
# glm-bridge — control del GLM-Bridge (start/stop/restart/status/logs/health)
# Solución a medida para ejecutar Claude Code oficial sobre GLM.
# ============================================================================
set -u
# resuelve symlinks para hallar el directorio real del script
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BRIDGE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PID_FILE="$BRIDGE_DIR/run/bridge.pid"
LOG_DIR="$BRIDGE_DIR/logs"
mkdir -p "$LOG_DIR" "$BRIDGE_DIR/run"

PORT="${GLM_BRIDGE_PORT:-8787}"
HOST="${GLM_BRIDGE_HOST:-127.0.0.1}"
OUT_LOG="$LOG_DIR/server.out"

is_running() {
  [ -f "$PID_FILE" ] || return 1
  local pid; pid="$(cat "$PID_FILE" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

health() {
  curl -fsS --max-time 3 "http://$HOST:$PORT/health" 2>/dev/null
}

wait_healthy() {
  for _ in $(seq 1 40); do
    if health >/dev/null 2>&1; then return 0; fi
    sleep 0.25
  done
  return 1
}

cmd_start() {
  if is_running && health >/dev/null 2>&1; then
    echo "glm-bridge: ya está en marcha (pid $(cat "$PID_FILE")) en http://$HOST:$PORT"
    return 0
  fi
  if is_running; then
    echo "glm-bridge: proceso previo (${pid:-$(cat "$PID_FILE")}) sin responder, matando..." >&2
    kill -9 "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
  fi
  echo "glm-bridge: iniciando en http://$HOST:$PORT ..."
  nohup node "$BRIDGE_DIR/bridge.mjs" >> "$OUT_LOG" 2>&1 &
  local pid=$!
  echo "$pid" > "$PID_FILE"
  if wait_healthy; then
    echo "glm-bridge: OK (pid $pid)"
    health
    return 0
  fi
  echo "glm-bridge: ERROR — no respondió a tiempo. Últimas líneas:" >&2
  tail -n 15 "$OUT_LOG" >&2
  return 1
}

cmd_stop() {
  if ! is_running; then
    echo "glm-bridge: no está en marcha"
    rm -f "$PID_FILE"
    return 0
  fi
  local pid; pid="$(cat "$PID_FILE")"
  echo "glm-bridge: deteniendo pid $pid ..."
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25
  done
  kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
  rm -f "$PID_FILE"
  echo "glm-bridge: detenido"
}

cmd_status() {
  if is_running; then
    echo "estado:   en marcha (pid $(cat "$PID_FILE"))"
  else
    echo "estado:   detenido"
  fi
  if h="$(health)"; then
    echo "health:   $h"
  else
    echo "health:   sin respuesta en http://$HOST:$PORT"
  fi
  echo "log:      $OUT_LOG"
}

cmd_logs() {
  tail -n "${1:-50}" "$OUT_LOG" 2>/dev/null || echo "sin logs aún"
}

cmd_follow() {
  tail -f "$OUT_LOG"
}

cmd_probe() {
  echo "Sonda de verificación del modelo real (2 llamadas API)..."
  node "$BRIDGE_DIR/probe.mjs"
}

# doctor — preflight completo para una sesión FRESCA de chat.z.ai:
# verifica entorno, credenciales de sesión, instalador de shims y bridge,
# sin gastar cuota de API (eso lo hace `probe`).
cmd_doctor() {
  local fails=0
  section() { echo; echo "── $1 ──"; }
  ok()   { echo "  ✓ $1"; }
  bad()  { echo "  ✗ $1"; fails=$((fails+1)); }

  section "Entorno"
  if command -v node >/dev/null 2>&1; then
    local nv; nv="$(node --version)"
    local major; major="${nv#v}"; major="${major%%.*}"
    if [ "$major" -ge 18 ]; then ok "node $nv"; else bad "node $nv (se requiere ≥ v18)"; fi
  else
    bad "node no encontrado (necesario para el bridge)"
  fi
  command -v curl >/dev/null 2>&1 && ok "curl disponible" || bad "curl no encontrado (glm-bridge health/probe lo usan)"

  section "Credenciales de sesión (nacimiento de la sesión, cero hardcoding)"
  local cfg_path="${ZAI_CONFIG_PATH:-}"
  # QA: GLM_QA_HIDE_SESSION=1 simula un entorno sin sesión (omite /etc)
  if [ "${GLM_QA_HIDE_SESSION:-}" != "1" ] && [ -z "$cfg_path" ] && [ -f /etc/.z-ai-config ]; then cfg_path=/etc/.z-ai-config; fi
  [ -z "$cfg_path" ] && [ -f "$HOME/.z-ai-config" ] && cfg_path="$HOME/.z-ai-config"
  [ -z "$cfg_path" ] && [ -f ./.z-ai-config ] && cfg_path="./.z-ai-config"
  if [ -n "$cfg_path" ] && [ -f "$cfg_path" ]; then
    ok "config de sesión: $cfg_path"
    node - "$cfg_path" <<'NODE' && ok "identidad de sesión válida (baseUrl+apiKey)" || bad "config sin baseUrl/apiKey o no-JSON"
const fs = require('fs');
const c = JSON.parse(fs.readFileSync(process.argv[2], 'utf-8'));
if (!c.baseUrl || !c.apiKey) process.exit(1);
console.log(`    baseUrl=${c.baseUrl} chatId=${c.chatId || '—'} token=${c.token ? '...(' + String(c.token).slice(-8) + ')' : 'ausente'} userId=${c.userId || '—'}`);
if (c.model) console.log(`    model (fichero de sesión)=${c.model}`);
NODE
  else
    bad "sin fichero de sesión (.z-ai-config) — ¿estás en una sesión de chat.z.ai?"
  fi

  section "Claude Code"
  local claude_bin=""
  if [ -n "${CLAUDE_BIN:-}" ] && [ -x "$CLAUDE_BIN" ]; then claude_bin="$CLAUDE_BIN"; fi
  [ -z "$claude_bin" ] && claude_bin="$(command -v claude 2>/dev/null || true)"
  [ -z "$claude_bin" ] && for p in "$HOME/.npm-global/bin/claude" "$HOME/.local/bin/claude" /usr/local/bin/claude /usr/bin/claude; do
    [ -x "$p" ] && { claude_bin="$p"; break; }
  done
  if [ -n "$claude_bin" ]; then
    ok "claude: $claude_bin ($("$claude_bin" --version 2>/dev/null | head -1 || echo 'versión desconocida'))"
    # comparación con la última release publicada en npm (informativo;
    # tolerante a offline: si no hay red se omite sin fallar)
    if command -v npm >/dev/null 2>&1; then
      latest_cc="$(timeout 6 npm view @anthropic-ai/claude-code version 2>/dev/null | tail -1 | tr -d '[:space:]')"
      inst_cc="$("$claude_bin" --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -1)"
      if [ -n "$latest_cc" ] && [ -n "$inst_cc" ]; then
        if [ "$inst_cc" = "$latest_cc" ]; then
          ok "claude-code al día ($inst_cc = última release en npm)"
        else
          echo "  · hay release nueva de Claude Code: $latest_cc (instalada: $inst_cc)"
          echo "      actualizar: npm install -g @anthropic-ai/claude-code@latest y luego ./qa.sh (valida compatibilidad offline)"
        fi
      else
        echo "  · no se pudo consultar npm (¿sin red?) — chequeo de versión omitido"
      fi
    fi
  else
    bad "claude no instalado → ejecuta: $BRIDGE_DIR/install.sh --with-claude"
  fi

  section "Shims en PATH"
  local shim_bin="${GLM_INSTALL_BIN:-$HOME/.local/bin}"
  for s in glm-claude glm-bridge; do
    if [ -e "$shim_bin/$s" ]; then
      ok "$shim_bin/$s → $(readlink -f "$shim_bin/$s" 2>/dev/null || echo enlace/copie)"
    elif command -v "$s" >/dev/null 2>&1; then
      ok "$s en PATH: $(command -v "$s")"
    else
      bad "$s no está en PATH → ejecuta: $BRIDGE_DIR/install.sh"
    fi
  done

  section "Bridge local"
  if is_running; then ok "proceso en marcha (pid $(cat "$PID_FILE"))"; else echo "  · detenido (se arranca solo al usar glm-claude)"; fi
  if h="$(health)"; then ok "health: $(echo "$h" | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{const j=JSON.parse(d);console.log(`v${j.version} | modelo=${j.model} | eco_gateway=${j.gateway_echo_model||"—"} | chatId=${j.session?.chatId||"—"} | token=${j.session?.token||"—"}`)}catch{console.log(d.slice(0,160))}})')"; else echo "  · sin respuesta (normal si está detenido)"; fi

  echo
  if [ "$fails" -eq 0 ]; then
    echo "doctor: TODO OK — sesión lista para Claude Code nativo sobre GLM (glm-claude)."
  else
    echo "doctor: $fails problema(s). Ejecuta: $BRIDGE_DIR/install.sh  (idempotente, repara lo que falte)"
    return 1
  fi
}

case "${1:-status}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status)  cmd_status ;;
  logs)    shift; cmd_logs "${1:-50}" ;;
  follow)  cmd_follow ;;
  health)  health || { echo "sin respuesta"; exit 1; } ;;
  probe)   cmd_probe ;;
  doctor)  cmd_doctor ;;
  *) echo "uso: glm-bridge {start|stop|restart|status|logs [n]|follow|health|probe|doctor}"; exit 2 ;;
esac
