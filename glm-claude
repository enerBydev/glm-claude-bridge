#!/usr/bin/env bash
# ============================================================================
# glm-claude — lanzador de Claude Code oficial sobre GLM vía GLM-Bridge.
# Uso: glm-claude [--model NOMBRE] [argumentos normales de claude]
#   glm-claude                       → REPL interactivo
#   glm-claude -p "haz X"            → modo no interactivo
#   glm-claude --model glm-x -p ...  → etiqueta de modelo para esta sesión
# Nota: el gateway Z.ai actualmente ignora el campo model (sirve su default);
# --model configura la etiqueta que CC ve/pide y que el bridge reenviará
# literal si el gateway algún día empieza a rutear por nombre.
# ============================================================================
set -eu
# resuelve symlinks para hallar el directorio real del script
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BRIDGE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PORT="${GLM_BRIDGE_PORT:-8787}"

# 0) --model exclusivo del lanzador (se consume y no llega a claude)
SESSION_MODEL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model)
      [ $# -ge 2 ] || { echo "glm-claude: --model requiere un valor" >&2; exit 2; }
      SESSION_MODEL="$2"; shift 2 ;;
    --model=*)
      SESSION_MODEL="${1#--model=}"; shift ;;
    *) break ;;
  esac
done
if [ -n "$SESSION_MODEL" ]; then
  export GLM_MODEL="$SESSION_MODEL"
fi

# 1) resolver el binario claude DINÁMICAMENTE (cero rutas fijas):
#    CLAUDE_BIN env > PATH > rutas comunes de instalación
resolve_claude() {
  if [ -n "${CLAUDE_BIN:-}" ] && [ -x "$CLAUDE_BIN" ]; then echo "$CLAUDE_BIN"; return 0; fi
  if command -v claude >/dev/null 2>&1; then command -v claude; return 0; fi
  local p
  for p in "$HOME/.npm-global/bin/claude" "$HOME/.local/bin/claude" \
           "/usr/local/bin/claude" "/usr/bin/claude" "$HOME/.claude/local/claude"; do
    [ -x "$p" ] && { echo "$p"; return 0; }
  done
  return 1
}
if ! CLAUDE_BIN_RESOLVED="$(resolve_claude)"; then
  echo "glm-claude: Claude Code no está instalado en esta sesión." >&2
  echo "  Instálalo con:  $BRIDGE_DIR/install.sh --with-claude" >&2
  echo "  (o instala claude por tu cuenta y define CLAUDE_BIN=/ruta/a/claude)" >&2
  exit 127
fi

# 2) puente en marcha (restart solo si --model cambió el modelo de sesión)
"$BRIDGE_DIR/glm-bridge" start >/dev/null 2>&1 || {
  "$BRIDGE_DIR/glm-bridge" start  # reintento verboso para ver el error
}
if [ -n "$SESSION_MODEL" ]; then
  "$BRIDGE_DIR/glm-bridge" restart >/dev/null 2>&1 || "$BRIDGE_DIR/glm-bridge" restart
fi
export ANTHROPIC_BASE_URL="http://127.0.0.1:${PORT}"
export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-glm-bridge-local}"
export ANTHROPIC_API_KEY=""                      # fuerza uso de AUTH_TOKEN
export ANTHROPIC_MODEL="${GLM_MODEL:-${GLM_DEFAULT_MODEL:-glm-5.3-flash}}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$ANTHROPIC_MODEL"

# thinking: el bridge v3 honra thinking:{type:'enabled'} si CC lo pide y
# traduce reasoning_content del upstream a bloques thinking de Anthropic.
# MAX_THINKING_TOKENS>0 hace que CC lo pida (pruébalo cuando haya cuota):
export MAX_THINKING_TOKENS="${MAX_THINKING_TOKENS:-0}"

# ventana de contexto: GLM en esta pasarela ~128k; evita el "unrecognized model"
export CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-128000}"

# tráfico no esencial fuera (telemetría, statsig, updater) — el bridge es local
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE="${CLAUDE_CODE_DISABLE_TERMINAL_TITLE:-1}"
export API_TIMEOUT_MS="${API_TIMEOUT_MS:-600000}"

# 3) onboarding ya completado (evita el asistente inicial en entornos headless)
CLAUDE_JSON="${HOME}/.claude.json"
if [ ! -f "$CLAUDE_JSON" ]; then
  printf '{"hasCompletedOnboarding":true,"theme":"dark"}' > "$CLAUDE_JSON"
fi

exec "$CLAUDE_BIN_RESOLVED" "$@"
